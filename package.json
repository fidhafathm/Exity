{
  "name": "exity",
  "version": "0.1.0",
  "private": true,
  "description": "Solana-based platform for tokenizing private equity LP stakes",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/exity"
  },
  "license": "MIT",
  "author": "FIDHA",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "install": "pnpm install --recursive",
    "build": "pnpm --filter \"./packages/**\" build",
    "build:contracts": "pnpm --filter contracts build",
    "build:frontend": "pnpm --filter frontend build",
    "build:sdk": "pnpm --filter sdk build",
    "build:shared": "pnpm --filter shared build",
    "test": "pnpm --filter \"./packages/**\" test",
    "test:contracts": "pnpm --filter contracts test",
    "test:frontend": "pnpm --filter frontend test",
    "test:sdk": "pnpm --filter sdk test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "deploy:devnet": "pnpm --filter contracts deploy:devnet",
    "deploy:mainnet": "pnpm --filter contracts deploy:mainnet",
    "prepare": "husky install",
    "clean": "pnpm --filter \"./packages/**\" clean && rm -rf node_modules"
  },
  "dependencies": {
  "react": "^18.2.0",
  "react-dom": "^18.2.0",
  "@solana/wallet-adapter-base": "^0.9.23",
  "@solana/wallet-adapter-react": "^0.15.35",
  "@solana/wallet-adapter-react-ui": "^0.9.35",
  "@solana/wallet-adapter-wallets": "^0.19.26",
  "@solana/web3.js": "^1.73.0",
  "axios": "^1.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
